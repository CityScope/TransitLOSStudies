# --- Python housekeeping ---
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.pytest_cache/
dist/
build/

# --- city_science_network: the study. Keep code, ignore data/results. ---
/city_science_network/data/
/city_science_network/figures/
/city_science_network/logs/
/city_science_network/*.log
/city_science_network/fake_cache_dir/
/city_science_network/combined_map.html
/city_science_network/watchdog.sh
/city_science_network/watchdog.log
/city_science_network/docs/

# Older/parallel study directories nested under city_science_network/ --
# raw downloaded data and earlier one-off studies, not source.
/city_science_network/boston_city/
/city_science_network/boston_city_evolution/
/city_science_network/census/
/city_science_network/china/
/city_science_network/streets/
/city_science_network/taiwan/
/city_science_network/worldpop/

# Defensive: a stray root-level copy of these (not nested under
# city_science_network/) can appear if a script is ever run with the wrong
# cwd/root -- real 2026-09-03 incident, cleaned up once, never trackable.
/census/
/streets/
/worldpop/

# Per-city directories: ignore everything except run.py (blanket-ignore
# each city dir's contents, then whitelist run.py; this covers whatever
# mix of raw data/results/backups accumulates there, not just the specific
# subfolder names we've seen so far).
/city_science_network/andorra/*
!/city_science_network/andorra/run.py
/city_science_network/beerseba/*
!/city_science_network/beerseba/run.py
/city_science_network/boston/*
!/city_science_network/boston/run.py
/city_science_network/concepcion/*
!/city_science_network/concepcion/run.py
/city_science_network/gipuzkoa/*
!/city_science_network/gipuzkoa/run.py
/city_science_network/guadalajara/*
!/city_science_network/guadalajara/run.py
/city_science_network/hamburg/*
!/city_science_network/hamburg/run.py
/city_science_network/san_francisco/*
!/city_science_network/san_francisco/run.py
/city_science_network/shanghai/*
!/city_science_network/shanghai/run.py
/city_science_network/taipei/*
!/city_science_network/taipei/run.py
/city_science_network/toronto/*
!/city_science_network/toronto/run.py

# --- usa_study: nationwide study. Keep code/main.py/prompt, ignore data. ---
# `data/` holds per-state downloaded GTFS + every generated geoparquet
# (hundreds of MB per state, fully regenerable by re-running main.py);
# `osm_files/` holds downloaded Geofabrik .osm.pbf extracts (per state,
# ~100-300MB each) -- same rationale, and re-downloading is cheap/cached
# by `county_pipeline.get_state_pbf` on the target machine anyway.
/usa_study/data/
/usa_study/osm_files/

# ===== Processing results are never tracked (only code) =====
# Anything a run produces -- data, tiles, maps, caches, logs, downloaded feeds / OSM extracts, audit tables -- stays local
# and is regenerable by re-running the code. Test fixtures under tests/ are code assets and stay trackable.

# Result / raw-data / cache file types (anywhere in the repo)
*.parquet
*.geoparquet
*.gpkg
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.pmtiles
*.mbtiles
*.pbf
*.osm.pbf
*.tif
*.tiff
*.npy
*.npz
*.pkl
*.pickle
*.feather
*.h5
*.hdf5
*.zip
*.log
nohup.out
*.tmp
*.part
.cache/
*_cache/
_network_cache*/
pycensus_cache/

# Generated maps and audit/summary tables
map.html
combined_map.html
*_map.html
feed_report.json
feed_exceptions.csv
feed_audit.csv
feed_size_audit.csv
feeds_dropped_by_analysis_date.csv
score_audit.csv
ptlos_by_state.csv
stops_signature.txt
h3_scheme_v*.txt

# Secrets / local configuration
api_keys.json
*.env
.env

# Study run folders. Studies keep code, prompts and orchestration scripts (*.py, *.sh, README, prompt.txt) only.
/usa_study/data/
/usa_study/osm_files/
/usa_study/logs/
/usa_study/logs_prev/
/usa_study/*.log
/city_science_network/**/tiles/
/city_science_network/**/results/
/city_science_network/**/map_tiles/
/city_science_network/**/stats_data.json
/**/tiles/
/**/output/
/**/outputs/

# Test fixtures are code assets: keep them trackable even though they match the types above.
!tests/**

# usa_study: only the study runner and the pipeline code are tracked -- main.py (`python main.py ALL` runs the complete
# study), code/*.py, build_usa_map.py (imported by main.py), README.md and prompt.txt. One-off helpers written while building
# or correcting the study (state-by-state re-runs, chained run scripts, migrations, audits, feed downloaders) stay local.
/usa_study/*.sh
/usa_study/audit_feeds.py
/usa_study/audit_scores.py
/usa_study/backfill_stop_signatures.py
/usa_study/fetch_missing_feeds.py
/usa_study/_local*/
/usa_study/tmp_*.py
